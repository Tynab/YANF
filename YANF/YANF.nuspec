<package >
  <metadata>
    <id>Tynab.YANF</id>
    <version>1.0.3</version>
    <title>YANF</title>
    <authors>Yami An</authors>
    <requireLicenseAcceptance>false</requireLicenseAcceptance>
    <license type="expression">MIT</license>
    <!-- <icon>icon.png</icon> -->
