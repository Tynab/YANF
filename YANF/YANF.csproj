<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- net481: .NET Framework apps. net8.0-windows: .NET 8 and 9 apps, which would otherwise get the net481 DLL through
         NuGet's .NET Framework fallback (warning NU1701). net10.0-windows: .NET 10 and later. The three builds have the
         same public API. A library gets no NETSDK1138 warning for net8.0 after .NET 8 support ends (10 Nov 2026);
         dropping it later is a package change that package validation reports (PKV006). -->
    <TargetFrameworks>net481;net8.0-windows;net10.0-windows</TargetFrameworks>
    <UseWindowsForms>true</UseWindowsForms>
    <LangVersion>12</LangVersion>
    <RootNamespace>YANF</RootNamespace>
    <AssemblyName>YANF</AssemblyName>
    <Deterministic>true</Deterministic>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <!-- Existing public members are documented in Vietnamese or not at all; missing docs are not build noise -->
    <NoWarn>$(NoWarn);CS1591</NoWarn>
  </PropertyGroup>

  <!-- Assembly and package metadata (formerly Properties/AssemblyInfo.cs and YANF.nuspec) -->
  <PropertyGroup>
    <!-- 2.0.0: a major version, with the breaking changes listed in CHANGELOG.md; the accepted differences from the 1.0.1
         baseline are listed in CompatibilitySuppressions.xml -->
    <Version>2.0.0</Version>
    <Title>YANF</Title>
    <Product>YANF</Product>
    <Company>YAN</Company>
    <Authors>Yami An</Authors>
    <Description>Yami An Nephilim Framework: custom controls, message box and loading screens for Windows Forms (C# and VB).</Description>
    <Copyright>Copyright © 2022 Yami An</Copyright>
    <PackageId>Tynab.YANF</PackageId>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/Tynab/YANF</PackageProjectUrl>
    <RepositoryUrl>https://github.com/Tynab/YANF</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageTags>C# VB .NET WinForms WindowsForms controls MessageBox</PackageTags>
    <PackageIcon>icon.png</PackageIcon>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageReleaseNotes>See https://github.com/Tynab/YANF/blob/main/CHANGELOG.md</PackageReleaseNotes>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <!-- Source Link comes with the .NET SDK (8.0.100 and later), no package needed: the Microsoft.SourceLink.GitHub 8.0.0
         package pulled in Microsoft.Build.Tasks.Git 8.0.0, which has a known vulnerability (NU1902) -->
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
    <ContinuousIntegrationBuild Condition="'$(GITHUB_ACTIONS)' == 'true'">true</ContinuousIntegrationBuild>
    <!-- Breaking changes against the last usable package are reported at pack time -->
    <EnablePackageValidation>true</EnablePackageValidation>
    <PackageValidationBaselineVersion>1.0.1</PackageValidationBaselineVersion>
  </PropertyGroup>

  <ItemGroup>
    <AssemblyAttribute Include="System.Runtime.InteropServices.ComVisibleAttribute">
      <_Parameter1>false</_Parameter1>
      <_Parameter1_IsLiteral>true</_Parameter1_IsLiteral>
    </AssemblyAttribute>
    <AssemblyAttribute Include="System.Runtime.InteropServices.GuidAttribute">
      <_Parameter1>40c18cf6-adc1-4b18-804d-7e42ee7d6db3</_Parameter1>
    </AssemblyAttribute>
    <AssemblyAttribute Include="System.Reflection.AssemblyTrademarkAttribute">
      <_Parameter1>Yami An</_Parameter1>
    </AssemblyAttribute>
    <InternalsVisibleTo Include="YANF.Tests" />
  </ItemGroup>

  <!-- No System.Design reference: YANDdl and YANTxt name its editors by assembly-qualified string, which needs none, and
       NuGet would pack one as a frameworkAssembly that adds System.Design to every .NET Framework consumer project (1.0.1
       added nothing). A compile-time need would take <Reference Include="System.Design" Pack="false" />. -->
  <ItemGroup Condition="'$(TargetFrameworkIdentifier)' == '.NETFramework'">
    <!-- Lets the .NET SDK build net481 without a targeting pack installed (CI, non-Windows); build-time only -->
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Update="Properties\Resources.resx">
      <Generator>ResXFileCodeGenerator</Generator>
      <LastGenOutput>Resources.Designer.cs</LastGenOutput>
    </EmbeddedResource>
    <Compile Update="Properties\Resources.Designer.cs">
      <DesignTime>True</DesignTime>
      <AutoGen>True</AutoGen>
      <DependentUpon>Resources.resx</DependentUpon>
    </Compile>
    <None Include="..\README.md" Pack="true" PackagePath="\" Visible="false" />
    <None Include="..\pic\0.png" Pack="true" PackagePath="\icon.png" Visible="false" />
  </ItemGroup>

</Project>
