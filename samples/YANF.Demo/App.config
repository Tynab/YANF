<?xml version="1.0" encoding="utf-8"?>
<!-- Read by the .NET Framework build (net481) only. DpiAwareness turns on the per-monitor DPI support of Windows Forms 4.7 and
     later: the forms and controls are rescaled when a window moves to a monitor with another DPI. It needs the Windows 10
     compatibility entry of app.manifest, and the awareness declared there must be the same. -->
<configuration>
  <startup>
    <supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.8.1" />
  </startup>
  <System.Windows.Forms.ApplicationConfigurationSection>
    <add key="DpiAwareness" value="PerMonitorV2" />
  </System.Windows.Forms.ApplicationConfigurationSection>
</configuration>
